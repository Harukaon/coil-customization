{
  "name": "@coilcoil/desktop",
  "version": "0.1.0-beta.149",
  "private": true,
  "description": "CoilCoil desktop Agent",
  "author": "Harukaon",
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "package": "npm run build:pi --prefix ../.. && node ../../scripts/sync-vendored-pi-model-data.mjs && npm run build --workspace @coilcoil/openai-responses-ws && npm run build && electron-builder",
    "package:dir": "npm run build:pi --prefix ../.. && node ../../scripts/sync-vendored-pi-model-data.mjs && npm run build --workspace @coilcoil/openai-responses-ws && npm run build && electron-builder --dir",
    "preview:ui": "vite build --config scripts/ui-preview/vite.config.ts"
  },
  "dependencies": {
    "@coilcoil/diagnostics": "0.1.0",
    "@coilcoil/openai-responses-ws": "0.1.0",
    "@coilcoil/runtime-core": "0.1.0",
    "@coilcoil/runtime-protocol": "0.1.0",
    "@coilcoil/runtime-server": "0.1.0",
    "@coilcoil/workflow": "0.1.0",
    "@earendil-works/pi-coding-agent": "file:../../vendor/pi/packages/coding-agent",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@xterm/addon-fit": "0.12.0-beta.220",
    "@xterm/xterm": "6.1.0-beta.220",
    "@xyflow/react": "^12.11.6",
    "chrome-devtools-mcp": "1.7.0",
    "jiti": "2.7.0",
    "lucide-react": "1.28.0",
    "node-pty": "1.2.0-beta.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "typebox": "1.3.7",
    "ws": "8.21.2"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  },
  "build": {
    "appId": "app.coilcoil.desktop",
    "productName": "CoilCoil",
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "**/node-pty/**",
      "**/@silvia-odwyer/photon-node/**",
      "**/chrome-devtools-mcp/**",
      "**/@coilcoil/workflow/skills/**"
    ],
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon-light.png",
        "to": "icons/icon-light.png"
      },
      {
        "from": "build/icon-dark.png",
        "to": "icons/icon-dark.png"
      }
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "hardenedRuntime": false,
      "timestamp": "none",
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "category": "Development",
      "icon": "build/icon.png",
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CoilCoil"
    }
  }
}
