{
  "name": "coilcoil",
  "version": "0.1.0-beta.149",
  "private": true,
  "description": "CoilCoil coding agent product",
  "author": "Harukaon",
  "repository": "github:Harukaon/CoilCoil",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/desktop",
    "apps/cli",
    "packages/diagnostics",
    "packages/mcp",
    "packages/runtime-core",
    "packages/runtime-protocol",
    "packages/runtime-server",
    "packages/openai-responses-ws",
    "packages/workflow"
  ],
  "scripts": {
    "setup": "npm ci --prefix vendor/pi --ignore-scripts && npm run hydrate:model-data --prefix vendor/pi && npm ci --ignore-scripts && npm run build:pi && npm run patch:chrome-devtools-mcp && npm rebuild node-pty esbuild && node node_modules/electron/install.js",
    "postinstall": "npm run patch:chrome-devtools-mcp",
    "patch:chrome-devtools-mcp": "node scripts/patch-chrome-devtools-mcp.mjs",
    "clean:pi-nested-deps": "node scripts/clean-vendor-pi-nested-deps.mjs",
    "release:version": "node scripts/set-release-version.mjs",
    "migrate:coilcoil-data": "node --experimental-strip-types scripts/migrate-coilcoil-data.mjs",
    "check": "npm run check --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:pi": "npm run clean:pi-nested-deps && npm run build:offline --prefix vendor/pi",
    "build": "npm run build:pi && npm run build --workspace @coilcoil/openai-responses-ws && npm run build --workspace @coilcoil/cli && npm run build --workspace @coilcoil/desktop",
    "dev": "npm run dev --workspace @coilcoil/desktop",
    "cli": "npm run dev --workspace @coilcoil/cli --",
    "package:desktop": "npm run package --workspace @coilcoil/desktop",
    "smoke": "npm run build && node scripts/runtime-smoke.mjs",
    "smoke:live": "npm run build && node scripts/runtime-smoke.mjs --live",
    "smoke:concurrency": "npm run build --workspace @coilcoil/desktop && node scripts/runtime-concurrency-smoke.mjs",
    "smoke:concurrency:live": "npm run build --workspace @coilcoil/desktop && node scripts/runtime-concurrency-smoke.mjs --live",
    "smoke:desktop": "node scripts/desktop-smoke.mjs",
    "e2e": "node scripts/e2e/run.mjs",
    "smoke:desktop:composer": "node scripts/desktop-composer-smoke.mjs",
    "smoke:desktop:layout": "node scripts/desktop-layout-smoke.mjs",
    "smoke:desktop:timeline": "node scripts/desktop-timeline-smoke.mjs",
    "smoke:desktop:browser-scope": "node scripts/browser-scope-smoke.mjs",
    "smoke:desktop:browser-workspace": "node scripts/browser-workspace-smoke.mjs",
    "smoke:desktop:browser-agent": "node scripts/browser-agent-smoke.mjs",
    "smoke:desktop:browser-fingerprint": "node scripts/browser-fingerprint-smoke.mjs",
    "smoke:desktop:live": "node scripts/desktop-smoke.mjs --live",
    "refresh:models": "cd vendor/pi/packages/ai && npm run hydrate-model-data"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "allowScripts": {
    "@google/genai@1.52.0": true,
    "electron@43.3.0": true,
    "electron-winstaller@5.4.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.1": true,
    "node-pty@1.1.0": true,
    "protobufjs@7.6.5": true
  },
  "devDependencies": {
    "playwright-core": "1.63.0"
  }
}
